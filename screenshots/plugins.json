{
  "$comment": "Each entry renders one plugin config page. `config` is what the stubbed ApiClient.getPluginConfiguration returns, so it decides exactly what the screenshot shows -- keep it realistic and free of anything real.",
  "plugins": [
    {
      "id": "imdb-rating-updater",
      "repo": "../jellyfin-imdb-rating-updater",
      "page": "Configuration/configPage.html",
      "output": "docs/images/imdb-ratings-settings.png",
      "config": {
        "MinimumVotes": 25,
        "IncludeMovies": true,
        "IncludeSeries": true,
        "IncludeSeasonAverages": true,
        "EnableMetadataProvider": true,
        "EnableItemDebugLogging": false
      }
    },
    {
      "id": "seerr-proxy",
      "repo": "../jellyfin-seerr-proxy",
      "page": "Configuration/configPage.html",
      "output": "docs/images/seerr-proxy-settings.png",
      "config": {
        "Enabled": true,
        "SeerrBaseUrl": "http://jellyseerr:5055",
        "SeerrApiKey": "MTc2MjkwMTQ0NTIzM2ZhOGQ0YzE5LWRlbW8ta2V5",
        "RequestTimeoutSeconds": 30
      }
    },
    {
      "id": "restore-userdata-after-move",
