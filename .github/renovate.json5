{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', 'group:allNonMajor'],
  // main has no branch protection, so GitHub's auto-merge is unavailable. Renovate merges
  // on its own next run, and only once every check on the PR has passed.
  platformAutomerge: false,
  // Majors wait on the Dependency Dashboard issue until approved there.
  major: {
    dependencyDashboardApproval: true,
  },
  packageRules: [
    {
      // Nobody reviews these before they merge, so a compromised publish gets a few days
      // to be caught and pulled first. Security fixes still come from Dependabot, which
      // does not wait.
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
      automerge: true,
      minimumReleaseAge: '3 days',
    },
    {
      // The screenshot harness. Nothing in CI runs it, so a bump is only exercised the
      // next time someone captures screenshots. A Playwright bump also brings a new
      // Chromium, which can shift rendering and churn every PNG in the plugin
      // repositories. capture-screenshots.sh only installs when node_modules is missing,
      // so delete screenshots/node_modules to pick up a merged bump. npm install runs on
      // a workstation with docker access, so these wait a week rather than three days.
      matchFileNames: ['screenshots/**'],
      minimumReleaseAge: '7 days',
    },
  ],
}
