{
  "$comment": "Each entry renders one plugin config page. `config` is what the stubbed ApiClient.getPluginConfiguration returns, so it decides exactly what the screenshot shows -- keep it realistic and free of anything real.",
  "plugins": [
    {
      "id": "imdb-ratings",
      "repo": "../jellyfin-plugin-imdb-ratings",
      "page": "Configuration/configPage.html",
      "output": "docs/images/imdb-ratings-settings.png",
      "config": {
        "MinimumVotes": 25,
        "IncludeMovies": true,
        "IncludeSeries": true,
        "IncludeSeasonAverages": true,
        "EnableMetadataProvider": true,
        "EnableItemDebugLogging": false
      }
    },
    {
      "id": "seerr-proxy",
      "repo": "../jellyfin-plugin-seerr-proxy",
      "page": "Configuration/configPage.html",
      "output": "docs/images/seerr-proxy-settings.png",
      "config": {
        "Enabled": true,
        "SeerrBaseUrl": "http://jellyseerr:5055",
        "SeerrApiKey": "MTc2MjkwMTQ0NTIzM2ZhOGQ0YzE5LWRlbW8ta2V5",
        "RequestTimeoutSeconds": 30,
        "$comment-ApiKeyFromEnvironment": "Set explicitly so the shot is deterministic. false renders the common case: the key stored in plugin configuration, with the note about admin credentials being able to read it back. true would blank and disable the field instead.",
        "ApiKeyFromEnvironment": false
      }
    },
    {
      "id": "restore-userdata-after-move",
      "repo": "../jellyfin-plugin-restore-userdata-after-move",
      "page": "src/Jellyfin.Plugin.UserDataRestore/Configuration/configPage.html",
      "output": "docs/images/restore-userdata-settings.png",
      "config": {
        "EligibleLibraryIds": [
          "a1f4c6d28e3b47f09c5d1e8a7b2f3c40",
          "b7e2d9c14a6f48b3812c5d0e9f3a7b61"
        ]
      },
      "api": {
        "getVirtualFolders": [
          {
            "Name": "Movies",
            "ItemId": "a1f4c6d28e3b47f09c5d1e8a7b2f3c40",
            "CollectionType": "movies"
          },
          {
            "Name": "TV Shows",
            "ItemId": "b7e2d9c14a6f48b3812c5d0e9f3a7b61",
            "CollectionType": "tvshows"
          },
          {
            "Name": "Anime",
            "ItemId": "c3a8b5e07d2f419e6a4b8c1d5e9f0a72",
            "CollectionType": "tvshows"
          },
          {
            "Name": "Documentaries",
            "ItemId": "d9c1e4a35b8f42d7903e6a2b8c4f1d53",
            "CollectionType": "movies"
          },
          {
            "Name": "Music",
            "ItemId": "e5b0a7c29f4d436a815c2e7b0d3f6a84",
            "CollectionType": "music"
          }
        ]
      }
    },
    {
      "id": "transcode-guard",
      "repo": "../jellyfin-plugin-transcode-guard",
      "page": "Configuration/configPage.html",
      "shots": [
        {
          "output": "docs/images/transcode-guard-playback-settings.png",
          "to": "Client Filters",
          "maxHeight": 1200
        },
        {
          "output": "docs/images/transcode-guard-login-monitor.png",
          "from": "Login Nag Settings",
          "to": "Transcode Limit"
        },
        {
          "output": "docs/images/transcode-guard-transcode-limit.png",
          "from": "Transcode Limit",
          "to": "Message of the Day",
          "maxHeight": 1500
        },
        {
          "output": "docs/images/transcode-guard-gpu-guard.png",
          "from": "GPU Resource Guard",
          "to": "Paused Transcode Reaper",
          "maxHeight": 1200
        },
        {
          "output": "docs/images/transcode-guard-paused-reaper.png",
          "from": "Paused Transcode Reaper",
          "maxHeight": 1700
        }
      ],
      "config": {
        "NagMessage": "This is transcoding and using extra server power. Try a client that can direct play this file.",
        "UseStickyPlaybackMessages": false,
        "DelaySeconds": 15,
        "MessageTimeoutMs": 10000,
        "EnableLogging": false,
        "ExcludeLiveTv": true,
        "IncludedClientPatterns": [],
        "ExcludedClientPatterns": [
          "Jellyfin Android TV",
          "Kodi*"
        ],
        "EnableLoginNag": true,
        "LoginNagThreshold": 5,
        "LoginNagTimeWindow": "Week",
        "LoginNagMessage": "You have transcoded {count} times this week. Check your client's playback settings.",
        "UseStickyLoginNagMessages": false,
        "$comment-EnableTranscodeLimit": "On, because off collapses the whole section to a single checkbox and there is nothing left to screenshot. Threshold sits above LoginNagThreshold, which is the way the page tells admins to set it.",
        "EnableTranscodeLimit": true,
        "TranscodeLimitThreshold": 15,
        "TranscodeLimitHeader": "Transcode limit reached",
        "TranscodeLimitMessage": "You've transcoded {{transcodes}} videos in the last {{timewindow}} due to unsupported formats, which is over this server's limit of {{limit}}. Switch to a client that can direct play (mpv, VLC, or Jellyfin Media Player) to keep watching.",
        "UseStickyTranscodeLimitMessages": false,
        "EnableMotd": true,
        "MotdMessage": "Scheduled maintenance this Sunday 02:00-04:00 UTC.",
        "UseStickyMotdMessages": true,
        "MotdIncludedClientPatterns": [],
        "MotdExcludedClientPatterns": [],
        "EnableGpuResourceGuard": true,
        "GpuIndex": 0,
        "GpuCheckTimeoutMilliseconds": 1000,
        "NvidiaSmiPath": "/usr/bin/nvidia-smi",
        "GpuGuardDeniedHeader": "Server busy",
        "GpuGuardDeniedMessage": "The GPU is at capacity right now. Try again in a few minutes.",
        "UseStickyGpuGuardMessages": false,
        "$comment-EnablePausedTranscodeReaper": "On for the same reason as the transcode limit: off hides every field behind it and leaves a lone checkbox to photograph. Values are the shipped defaults.",
        "EnablePausedTranscodeReaper": true,
        "PausedTranscodeTimeoutMinutes": 25,
        "PausedTranscodeWarningMinutes": 2,
        "PausedTranscodeWarningHeader": "Still there?",
        "PausedTranscodeWarningMessage": "Your paused video will be stopped in {{minutes}} minute(s) to free up server resources. Press play to keep watching.",
        "UseStickyPausedTranscodeMessages": false,
        "ReapPausedDirectPlay": false,
        "ExcludedUserIds": [],
        "MotdExcludedUserIds": [],
        "PausedTranscodeExcludedUserIds": [],
        "AlertTranscodeReasons": [
          "ContainerNotSupported",
          "VideoCodecNotSupported",
          "AudioCodecNotSupported",
          "VideoResolutionNotSupported",
          "VideoBitDepthNotSupported",
          "VideoRangeTypeNotSupported"
        ],
        "ReasonMessageOverrides": {}
      },
      "api": {
        "getUsers": [
          {
            "Id": "4e6ea05698214e7c940d2af1806f1f8e",
            "Name": "demo"
          },
          {
