          }
        ],
        "getSessions": [
          {
            "UserId": "7a2c9d0b5e134f8a96b3c7d1e0f2a845",
            "UserName": "livingroom",
            "Client": "Jellyfin Web",
            "DeviceName": "Firefox",
            "NowPlayingItem": {
              "Name": "Nosferatu (1922)",
              "Type": "Movie"
            },
            "TranscodingInfo": {
